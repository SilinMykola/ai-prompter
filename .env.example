# Copy this file to .env and fill in the keys. .env is git-ignored, never commit it.

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Default provider: gemini | anthropic
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# Optional. By default the app asks the Gemini API for its models and picks sensible defaults.
# Set a comma-separated list to offer exactly these models instead:
# first = fast (translation), second = strong (detailed hints).
GEMINI_MODELS=

ANTHROPIC_API_KEY=
# Optional, same meaning as GEMINI_MODELS. Example: claude-haiku-5-5,claude-sonnet-5-5
ANTHROPIC_MODELS=

# Node server (listens on 127.0.0.1 only)
PORT=8787
# Vite dev server. 5173 and 5180 are used by other local apps on the author's machine.
WEB_PORT=5175
