# Copy this file to .env and fill in the keys. .env is git-ignored, never commit it.

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Default provider: gemini | anthropic
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# Comma-separated; first = fast (translation), second = strong (detailed hints).
# Filled in once the current model IDs are checked against the Gemini docs.
GEMINI_MODELS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5-5

# Node server (listens on 127.0.0.1 only)
PORT=8787
# Vite dev server. 5173 and 5180 are used by other local apps on the author's machine.
WEB_PORT=5175
